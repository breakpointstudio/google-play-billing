{
    "name": "breakpoint/google-play-billing",
    "description": "Google Play Billing validation, Laravel integration, and Real-time Developer Notifications for Slopes.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "google/apiclient": "^2.15",
        "illuminate/support": "^12.0|^13.0",
        "nesbot/carbon": "^2.0|^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Breakpoint\\GooglePlay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Breakpoint\\GooglePlay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Breakpoint\\GooglePlay\\GooglePlayServiceProvider"
            ]
        },
        "google/apiclient-services": [
            "AndroidPublisher"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
